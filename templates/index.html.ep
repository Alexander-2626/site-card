lue="px" data-field-heightunits-value="px" data-field-widthunits-value="px" data-field-heightmode-value="hug" data-field-top-res-320-value="262" data-field-left-res-320-value="686" data-field-top-res-1200-value="262" data-field-left-res-1200-value="686"> <div class='tn-atom tn-atom__vector'> <?xml version="1.0" encoding="UTF-8"?> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 494 248" fill="none"> <path d="M0 30C0 13.43145 13.43145 0 30 0H464C480.5675 0 494 13.43145 494 30V218C494 234.5685 480.5675 248 464 248H30C13.43145 248 0 234.5685 0 218V30Z" fill="#9CC0DA"></path> </svg> </div> </div> <div class='t396__elem tn-elem tn-elem__14025692611759910777664' data-elem-id='1759910777664' data-elem-type='text' data-field-top-value="370" data-field-left-value="838" data-field-height-value="120" data-field-width-value="469" data-field-axisy-value="top" data-field-axisx-value="left" data-field-container-value="grid" data-field-topunits-value="px" data-field-leftunits-value="px" data-field-heightunits-value="px" data-field-widthunits-value="px" data-field-textfit-value="autoheight" data-field-fontsize-value="20" data-field-top-res-320-value="370" data-field-left-res-320-value="698" data-field-top-res-1200-value="370" data-field-left-res-1200-value="698"> <div class='tn-atom'field='tn_text_1759910777664'>Создание MVP под конкретные задачи бизнеса.<br>Интеграция готовых ИИ-инструментов (чат-боты, аналитика, компьютерное зрение и т. д.).<br>Кастомизация решений под российские реалии (язык, законодательство, инфраструктура).</div> </div> <div class='t396__elem tn-elem tn-elem__14025692611759910777623' data-elem-id='1759910777623' data-elem-type='text' data-field-top-value="282" data-field-left-value="838" data-field-height-value="100" data-field-width-value="469" data-field-axisy-value="top" data-field-axisx-value="left" data-field-container-value="grid" data-field-topunits-value="px" data-field-leftunits-value="px" data-field-heightunits-value="px" data-field-widthunits-value="px" data-field-textfit-value="autoheight" data-field-fontsize-value="20" data-field-top-res-320-value="282" data-field-left-res-320-value="698" data-field-top-res-1200-value="282" data-field-left-res-1200-value="698"> <div class='tn-atom'field='tn_text_1759910777623'>Разработка и адаптация <br>ИИ-решений<br><br><br></div> </div> <div class='t396__elem tn-elem tn-elem__14025692611759910777628' data-elem-id='1759910777628' data-elem-type='vector' data-field-top-value="262" data-field-left-value="120" data-field-height-value="510" data-field-width-value="692" data-field-axisy-value="top" data-field-axisx-value="left" data-field-container-value="grid" data-field-topunits-value="px" data-field-leftunits-value="px" data-field-heightunits-value="px" data-field-widthunits-value="px" data-field-heightmode-value="hug" data-field-top-res-320-value="262" data-field-left-res-320-value="21" data-field-top-res-1200-value="262" data-field-left-res-1200-value="21" data-field-width-res-1200-value="601"> <div class='tn-atom tn-atom__vector'> <?xml version="1.0" encoding="UTF-8"?> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 692 510" fill="none"> <path d="M0 30C0 13.43145 13.43145 0 30 0H662C678.5675 0 692 13.43145 692 30V480C692 496.5675 678.5675 510 662 510H30C13.43145 510 0 496.5675 0 480V30Z" fill="#9CC0DA"></path> </svg> </div> </div> <div class='t396__elem tn-elem tn-elem__14025692611759910777629' data-elem-id='1759910777629' data-elem-type='text' data-field-top-value="613" data-field-left-value="136" data-field-height-value="147" data-field-width-value="657" data-field-axisy-value="top" data-field-axisx-value="left" data-field-container-value="grid" data-field-topunits-value="px" data-field-leftunits-value="px" data-field-heightunits-value="px" data-field-widthunits-value="px" data-field-textfit-value="autoheight" data-field-fontsize-value="20" data-field-top-res-320-value="551" data-field-left-res-320-value="36" data-field-top-res-1200-value="551" data-field-left-res-1200-value="36" data-field-width-res-1200-value="549"> <div class='tn-atom'field='tn_text_1759910777629'><br><br>Какие ИИ-решения востребованы в&nbsp;разных нишах (ритейл, производство, услуги, логистика и&nbsp;т.&nbsp;д.). Выявление «болевых точек» бизнеса, где&nbsp;ИИ даст быстрый эффект (автоматизация, прогнозирование, персонализация).</div> </div> <div class='t396__elem tn-elem tn-elem__14025692611759910777632' data-elem-id='1759910777632' data-elem-type='text' data-field-top-value="282" data-field-left-value="136" data-field-height-value="50" data-field-width-value="577" data-field-axisy-value="top" data-field-axisx-value="left" data-field-container-value="grid" data-field-topunits-value="px" data-field-leftunits-value="px" data-field-heightunits-value="px" data-field-widthunits-value="px" data-field-textfit-value="autoheight" data-field-fontsize-value="20" data-field-top-res-320-value="280" data-field-left-res-320-value="36" data-field-top-res-1200-value="280" data-field-left-res-1200-value="36" data-field-width-res-1200-value="526"> <div class='tn-atom'field='tn_text_1759910777632'>Анализ и выявление потребностей бизнеса и исследование рынка</div> </div> <div class='t396__elem tn-elem tn-elem__14025692611759910777635' data-elem-id='1759910777635' data-elem-type='vector' data-field-top-value="521" data-field-left-value="826" data-field-height-value="248" data-field-width-value="494" data-field-axisy-value="top" data-field-axisx-value="left" data-field-container-value="grid" data-field-topunits-value="px" data-field-leftunits-value="px" data-field-heightunits-value="px" data-field-widthunits-value="px" data-field-heightmode-value="hug" data-field-top-res-320-value="519" data-field-left-res-320-value="695" data-field-top-res-1200-value="519" data-field-left-res-1200-value="695" data-field-width-res-1200-value="487"> <div class='tn-atom tn-atom__vector'> <?xml version="1.0" encoding="UTF-8"?> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 494 248" fill="none"> <path d="M0 30C0 13.43145 13.43145 0 30 0H464C480.5675 0 494 13.43145 494 30V218C494 234.5685 480.5675 248 464 248H30C13.43145 248 0 234.5685 0 218V30Z" fill="#08020E"></path> </svg> </div> </div> <div class='t396__elem tn-elem tn-elem__14025692611759910777637' data-elem-id='1759910777637' data-elem-type='text' data-field-top-value="633" data-field-left-value="841" data-field-height-value="120" data-field-width-value="480" data-field-axisy-value="top" data-field-axisx-value="left" data-field-container-value="grid" data-field-topunits-value="px" data-field-leftunits-value="px" data-field-heightunits-value="px" data-field-widthunits-value="px" data-field-textfit-value="autoheight" data-field-fontsize-value="20" data-field-top-res-320-value="630" data-field-left-res-320-value="710" data-field-top-res-1200-value="630" data-field-left-res-1200-value="710" data-field-width-res-1200-value="479"> <div class='tn-atom'field='tn_text_1759910777637'>Техническая интеграция с существующими системами компаний (1С, CRM, ERP).<br>Обучение сотрудников клиентов работе с ИИ.<br>Техподдержка и доработка решений по обратной связи.<br></div> </div> <div class='t396__elem tn-elem tn-elem__14025692611759910777640' data-elem-id='1759910777640' data-elem-type='text' data-field-top-value="538" data-field-left-value="846" data-field-height-value="25" data-field-width-value="475" data-field-axisy-value="top" data-field-axisx-value="left" data-field-container-value="grid" data-field-topunits-value="px" data-field-leftunits-value="px" data-field-heightunits-value="px" data-field-widthunits-value="px" data-field-textfit-value="autoheight" data-field-fontsize-value="20" data-field-top-res-320-value="536" data-field-left-res-320-value="715" data-field-top-res-1200-value="536" data-field-left-res-1200-value="715" data-field-width-res-1200-value="474"> <div class='tn-atom'field='tn_text_1759910777640'>Внедрение и поддержка</div> </div> <div class='t396__elem tn-elem tn-elem__14025692611759910777643' data-elem-id='1759910777643' data-elem-type='vector' data-field-top-value="786" data-field-left-value="120" data-field-height-value="248" data-field-width-value="692" data-field-axisy-value="top" data-field-axisx-value="left" data-field-container-value="grid" data-field-topunits-value="px" data-field-leftunits-value="px" data-field-heightunits-value="px" data-field-widthunits-value="px" data-field-heightmode-value="hug" data-field-top-res-320-value="725" data-field-left-res-320-value="21" data-field-top-res-1200-value="725" data-field-left-res-1200-value="21" data-field-width-res-1200-value="599" data-field-widthmode-res-1200-value="fixed"> <div class='tn-atom tn-atom__vector'> <?xml version="1.0" encoding="UTF-8"?> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 692 248" fill="none"> <path d="M0 30C0 13.43145 13.43145 0 30 0H662C678.5675 0 692 13.43145 692 30V218C692 234.5685 678.5675 248 662 248H30C13.43145 248 0 234.5685 0 218V30Z" fill="#9CC0DA"></path> </svg> </div> </div> <div class='t396__elem tn-elem tn-elem__14025692611759910777645' data-elem-id='1759910777645' data-elem-type='text' data-field-top-value="900" data-field-left-value="137" data-field-height-value="120" data-field-width-value="657" data-field-axisy-value="top" data-field-axisx-value="left" data-field-container-value="grid" data-field-topunits-value="px" data-field-leftunits-value="px" data-field-heightunits-value="px" data-field-widthunits-value="px" data-field-textfit-value="autoheight" data-field-fontsize-value="20" data-field-top-res-320-value="776" data-field-left-res-320-value="30" data-field-top-res-1200-value="776" data-field-left-res-1200-value="30" data-field-width-res-1200-value="490"> <div class='tn-atom'field='tn_text_1759910777645'><br><br>Выбор модели продаж: подписка, разовые внедрения, revenue share. Партнерства с вендорами (например, Яндекс, Сбер, отечественные ИИ-стартапы).<br></div> </div> <div class='t396__elem tn-elem tn-elem__14025692611759910777647' data-elem-id='1759910777647' data-elem-type='text' data-field-top-value="806" data-field-left-value="137" data-field-height-value="25" data-field-width-value="657" data-field-axisy-value="top" data-field-axisx-value="left" data-field-container-value="grid" data-field-topunits-value="px" data-field-leftunits-value="px" data-field-heightunits-value="px" data-field-widthunits-value="px" data-field-textfit-value="autoheight" data-field-fontsize-value="20" data-field-top-res-320-value="740" data-field-left-res-320-value="39" data-field-top-res-1200-value="740" data-field-left-res-1200-value="39" data-field-width-res-1200-value="490"> <div class='tn-atom'field='tn_text_1759910777647'>Монетизация и масштабирование</div> </div> <div class='t396__elem tn-elem tn-elem__14025692611759910777650' data-elem-id='1759910777650' data-elem-type='vector' data-field-top-value="786" data-field-left-value="826" data-field-height-value="510" data-field-width-value="494" data-field-axisy-value="top" data-field-axisx-value="left" data-field-container-value="grid" data-field-topunits-value="px" data-field-leftunits-value="px" data-field-heightunits-value="px" data-field-widthunits-value="px" data-field-heightmode-value="hug" data-field-top-res-320-value="772" data-field-left-res-320-value="685" data-field-top-res-1200-value="772" data-field-left-res-1200-value="685" data-field-width-res-1200-value="503"> <div class='tn-atom tn-atom__vector'> <?xml version="1.0" encoding="UTF-8"?> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <!--?xml version="1.0" encoding="UTF-8"?--> <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 494 510" fill="none"> <path d="M0 30C0 13.43145 13.43145 0 30 0H464C480.5675 0 494 13.43145 494 30V480C494 496.5675 480.5675 510 464 510H30C13.43145 510 0 496.5675 0 480V30Z" fill="#08020E"></path> </svg> </div> </div> <div class='t396__elem tn-elem tn-elem__14025692611759910777651' data-elem-id='1759910777651' data-elem-type='text' data-field-top-value="1138" data-field-left-value="838" data-field-height-value="147" data-field-width-value="424" data-field-axisy-value="top" data-field-axisx-value="left" data-field-container-value="grid" data-field-topunits-value="px" data-field-leftunits-value="px" data-field-heightunits-value="px" data-field-widthunits-value="px" data-field-textfit-value="autoheight" data-fiel