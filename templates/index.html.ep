role="img"> </div> </div> <div class='t396__elem tn-elem tn-elem__14030011511759914380544' data-elem-id='1759914380544' data-elem-type='text' data-field-top-value="361" data-field-left-value="124" data-field-height-value="168" data-field-width-value="513" data-field-axisy-value="top" data-field-axisx-value="left" data-field-container-value="grid" data-field-topunits-value="px" data-field-leftunits-value="px" data-field-heightunits-value="px" data-field-widthunits-value="px" data-field-textfit-value="autoheight" data-field-fontsize-value="16" data-field-top-res-320-value="105" data-field-left-res-320-value="19" data-field-height-res-320-value="231" data-field-width-res-320-value="283" data-field-fontsize-res-320-value="14" data-field-top-res-960-value="291" data-field-left-res-960-value="285" data-field-height-res-960-value="192" data-field-width-res-960-value="423" data-field-top-res-1200-value="364" data-field-left-res-1200-value="103" data-field-height-res-1200-value="120" data-field-width-res-1200-value="423" data-field-container-res-1200-value="grid" data-field-heightunits-res-1200-value="px" data-field-textfit-res-1200-value="autoheight" data-field-fontsize-res-1200-value="16"> <div class='tn-atom'field='tn_text_1759914380544'>Развернули собственную модель искусственного интеллекта для ведущего банка, обеспечив полное обучение сотрудников и&nbsp;соблюдение стандартов безопасности. В&nbsp;строительном холдинге внедрили ИИ-решения в&nbsp;ключевые процессы управления проектами. Внедрили&nbsp;ИИ в&nbsp;процессы обучения в&nbsp;самой крупной транспортной компании 700 000+ сотрудников, повысив скорость адаптации и&nbsp;качество внутреннего сервиса.</div> </div> <div class='t396__elem tn-elem tn-elem__14030011511759914380517' data-elem-id='1759914380517' data-elem-type='text' data-field-top-value="272" data-field-left-value="230" data-field-height-value="45" data-field-width-value="302" data-field-axisy-value="top" data-field-axisx-value="left" data-field-container-va