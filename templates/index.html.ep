yle,solid);border-color:var(--t396-bordercolor,transparent);}#rec1402850521 .tn-elem[data-elem-id="1759913154528"] .tn-atom::after{display:none;}#rec1402850521 .tn-elem[data-elem-id="1759913154528"] .tn-atom .tn-atom__button-text{overflow:visible;}#rec1402850521 .tn-elem[data-elem-id="1759913154528"] .tn-atom .tn-atom__button-border::before{display:none;}#rec1402850521 .tn-elem[data-elem-id="1759913154528"] .tn-atom .tn-atom__button-border::after{display:none;}@media (hover),(min-width:0\0){#rec1402850521 .tn-elem[data-elem-id="1759913154528"] .tn-atom:hover::after{opacity:0;}#rec1402850521 .tn-elem[data-elem-id="1759913154528"] .tn-atom:hover{animation-name:none;}}@media (hover),(min-width:0\0){#rec1402850521 .tn-elem[data-elem-id="1759913154528"] .tn-atom:hover{border-style:var(--t396-borderstyle,solid);border-color:var(--t396-bordercolor-hover,var(--t396-bordercolor,transparent));}}}</style> <div class='t396'> <div class="t396__artboard" data-artboard-recid="1402850521" data-artboard-screens="320,960,1200,1400" data-artboard-height="431" data-artboard-valign="center" data-artboard-upscale="window" data-artboard-height-res-320="300"> <div class="t396__carrier" data-artboard-recid="1402850521"></div> <div class="t396__filter" data-artboard-recid="1402850521"></div> <div class='t396__elem tn-elem tn-elem__14028505211759913120975 t-animate' data-elem-id='1759913120975' data-elem-type='text' data-field-top-value="197" data-field-left-value="0" data-field-height-value="50" data-field-width-value="1400" data-field-axisy-value="top" data-field-axisx-value="left" data-field-container-value="grid" data-field-topunits-value="px" data-field-leftunits-value="px" data-field-heightunits-value="px" data-field-widthunits-value="px" data-animate-style="fadeinup" data-animate-duration="1" data-animate-distance="100" data-animate-mobile="y" data-field-textfit-value="autoheight" data-field-fontsize-value="20" data-field-top-res-320-value="96" data-field-left-res-320-value="11" data-f