% layout 'default', title => 'Искусственный интеллект для бизнеса';
<section class="hero">
  <div class="hero__inner">
    <div class="hero__text">
      <h1 class="hero__title">Искусственный интеллект для бизнеса</h1>
      <p class="hero__subtitle">Внедрение искусственного интеллекта в&nbsp;бизнес и&nbsp;обучение сотрудников работе с&nbsp;нейросетями</p>
      <div class="hero__buttons">
        <a class="btn btn--accent" href="https://t.me/AI_vnedri">Обсудить проект</a>
        <a class="btn btn--dark" href="#audit">Бесплатный аудит</a>
      </div>
    </div>
    <div class="hero__image">
      <img src="/img/robot.png" alt="Робот-рука с ИИ">
    </div>
  </div>
</section>